# Copy to .env (Docker) or /etc/mini-siem/env (systemd install) and fill in.
# Never commit the real file.

# --- Telegram alerts (optional) ---------------------------------------------
# Create a bot with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# Leave empty to only log alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Name shown in Telegram messages (defaults to the machine hostname).
SIEM_HOSTNAME=

# --- Dashboard authentication (optional, recommended) ------------------------
# The dashboard only listens on 127.0.0.1 and is meant to be reached through
# an SSH tunnel. Setting either of these adds a second layer.
# HTTP basic auth (browser prompt):
SIEM_DASHBOARD_USER=
SIEM_DASHBOARD_PASSWORD=
# Bearer token for scripts: curl -H "Authorization: Bearer $TOKEN" ...
SIEM_DASHBOARD_TOKEN=
